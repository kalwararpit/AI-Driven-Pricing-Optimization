   "source": [
    "price_changes = [-0.10, -0.05, 0, 0.05, 0.10]\n",
    "\n",
    "current_price = df['price'].mean()\n",
    "current_demand = df['units_sold'].mean()\n",
    "\n",
    "simulation_results = []\n",
    "\n",
    "for change in price_changes:\n",
    "    new_price = current_price * (1 + change)\n",
    "    predicted_demand = current_demand * (new_price / current_price) ** elasticity\n",
    "    revenue = new_price * predicted_demand\n",
    "    \n",
    "    simulation_results.append({\n",
    "        \"price_change_%\": f\"{int(change*100)}%\",\n",
    "        \"new_price\": round(new_price, 2),\n",
    "        \"predicted_demand\": round(predicted_demand),\n",
    "        \"predicted_revenue\": round(revenue, 2)\n",
    "    })\n",
    "\n",
    "simulation_df = pd.DataFrame(simulation_results)\n",
    "simulation_df\n"
   ]
  },
