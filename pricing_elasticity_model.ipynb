   "source": [
    "from sklearn.linear_model import LinearRegression\n",
    "import numpy as np\n",
    "\n",
    "# log transforms\n",
    "df['log_price'] = np.log(df['price'])\n",
    "df['log_units'] = np.log(df['units_sold'])\n",
    "\n",
    "X = df[['log_price', 'promotion']]\n",
    "y = df['log_units']\n",
    "\n",
    "model_ctrl = LinearRegression()\n",
    "model_ctrl.fit(X, y)\n",
    "\n",
    "elasticity_ctrl = model_ctrl.coef_[0]\n",
    "promo_effect = model_ctrl.coef_[1]\n",
    "\n",
    "elasticity_ctrl, promo_effect\n"
   ]
